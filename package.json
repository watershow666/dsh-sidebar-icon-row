{
  "name": "dsh-sidebar-icon-row",
  "version": "1.1.0",
  "private": true,
  "description": "Turn DeepSeek Harness sidebar entries into a compact icon row with adjustable icon size, per-entry visibility and ordering, plus a Settings shortcut in the footer row.",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "LICENSE",
    "screenshots.json",
    "assets/*.png"
  ],
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "immediately": true
    }
  }
}
